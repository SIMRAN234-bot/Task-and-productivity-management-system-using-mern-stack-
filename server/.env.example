# ===================================================
# TaskFlow Server - Environment Configuration Example
# Copy this file to .env and replace the values below
# ===================================================

# Server Port
PORT=5000

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# MongoDB Connection String (Atlas or Local)
# Atlas Format: mongodb+srv://<username>:<password>@<cluster-url>/taskflow?retryWrites=true&w=majority
# Local Format: mongodb://127.0.0.1:27017/taskflow
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/taskflow?retryWrites=true&w=majority

# JSON Web Token Secret & Expiration
# Generate a secure secret using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_secure_random_64_char_hex_secret
JWT_EXPIRE=7d

# Client URL for CORS Whitelisting
CLIENT_URL=http://localhost:5173
